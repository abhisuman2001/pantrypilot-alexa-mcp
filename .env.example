# PantryPilot – environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── AWS (required for Bedrock) ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# ── Bedrock model ───────────────────────────────────────────────────────────
# Enable the model in the Bedrock console first:
# https://console.aws.amazon.com/bedrock/home#/modelaccess
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
PANTRY_DB=pantry.db          # path to SQLite file; container default is /data/pantry.db

# ── Multi-user ──────────────────────────────────────────────────────────────
DEFAULT_OWNER=default         # fallback owner when no X-User-ID header is present

# ── Auth (optional) ─────────────────────────────────────────────────────────
# Set a random secret to require "Authorization: Bearer <key>" on every call.
# Leave blank to disable auth (fine for local dev).
MCP_API_KEY=
